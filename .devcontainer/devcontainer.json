{
    "name": "AI Research Assistant",
    "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

    // Install uv, then sync all dependencies (including eval extras) into a
    // project-local .venv.  uv is ~10x faster than pip so Codespace startup
    // stays under a minute.  Re-runs automatically whenever repo content changes.
    "updateContentCommand": "pip install uv && uv sync --extra eval",

    // Start the Streamlit app when the user attaches.  The API key must be set
    // as a Codespaces user secret (see remoteEnv below) for the app to work.
    "postAttachCommand": {
        "server": "uv run streamlit run streamlit_app.py --server.enableCORS false --server.enableXsrfProtection false"
    },

    // Map Codespaces user secrets → container environment variables.
    // Set these at: github.com/settings/codespaces (or the repo Settings > Secrets).
    "remoteEnv": {
        "ANTHROPIC_API_KEY":        "${localEnv:ANTHROPIC_API_KEY}",
        "OPENAI_API_KEY":           "${localEnv:OPENAI_API_KEY}",
        "GEMINI_API_KEY":           "${localEnv:GEMINI_API_KEY}",
        "SEMANTIC_SCHOLAR_API_KEY": "${localEnv:SEMANTIC_SCHOLAR_API_KEY}"
    },

    "customizations": {
        "codespaces": {
            "openFiles": ["streamlit_app.py"]
        },
        "vscode": {
            "settings": {
                // Point VS Code at the uv-managed venv so IntelliSense resolves imports
                "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ]
        }
    },

    "portsAttributes": {
        "8501": {
            "label": "Streamlit app",
            "onAutoForward": "openPreview"
        }
    },
    "forwardPorts": [8501]
}
